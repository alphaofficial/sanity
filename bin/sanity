#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: sanity [--staged|--changed|--branch [base-ref]] [--json] [--clipboard] [--help]

Lint JavaScript and TypeScript changes in the current Git repository.

Options:
  --staged   Lint staged lines. This is the default.
  --changed  Lint tracked lines changed in the working tree.
  --branch [base-ref]
             Lint lines changed on the current branch since it forked from
             base-ref. Defaults to the repository's default branch.
  --json     Print ESLint JSON formatter output.
  --clipboard
             Copy the printed output to the system clipboard.
  --help     Show this help.
USAGE
}

mode="staged"
branch_base=""
json="0"
clipboard="0"

while (($#)); do
  case "$1" in
    --staged)
      mode="staged"
      ;;
    --changed|--tracked)
      mode="changed"
      ;;
    --branch)
      mode="branch"
      if [[ "${2:-}" != "" && "${2:0:1}" != "-" ]]; then
        branch_base="$2"
        shift
      fi
      ;;
    --branch=*)
      mode="branch"
      branch_base="${1#--branch=}"
      if [[ "$branch_base" == "" ]]; then
        printf 'Missing branch base ref after --branch=.\n\n' >&2
        usage >&2
        exit 2
      fi
      ;;
    --json)
      json="1"
      ;;
    --clipboard)
      clipboard="1"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input
  elif command -v clip.exe >/dev/null 2>&1; then
    clip.exe
  else
    return 1
  fi
}

print_and_maybe_copy() {
  local output="$1"

  printf '%s\n' "$output"

  if [[ "$clipboard" == "1" ]]; then
    if ! printf '%s\n' "$output" | copy_to_clipboard; then
      printf 'sanity could not find a supported clipboard command.\n' >&2
    fi
  fi
}

fatal() {
  local message="$1"

  if [[ "$json" == "1" ]]; then
    print_and_maybe_copy "$(printf '{"fatal":true,"message":%s}' "$(node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$message")")"
  else
    output="$(gum style --foreground 196 --bold "Fatal error"; gum style "$message")"
    print_and_maybe_copy "$output"
  fi
  exit 2
}

if [[ "$json" != "1" ]] && ! command -v gum >/dev/null 2>&1; then
  printf 'sanity requires Gum for terminal output: https://github.com/charmbracelet/gum\n' >&2
  exit 2
fi

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  fatal "sanity must be run from inside a Git repository."
fi

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done

script_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
runner="$script_dir/../src/run-eslint.js"

detect_default_branch() {
  local remote_head candidate

  if remote_head="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    printf '%s\n' "$remote_head"
    return 0
  fi

  for candidate in origin/main origin/master main master; do
    if git -C "$repo_root" rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

declare -a git_args
case "$mode" in
  staged)
    git_args=(diff --cached --name-only -z --diff-filter=ACMR)
    ;;
  changed)
    git_args=(diff --name-only -z --diff-filter=ACMR)
    ;;
  branch)
    if [[ "$branch_base" == "" ]]; then
      if ! branch_base="$(detect_default_branch)"; then
        fatal "sanity could not detect a default branch. Pass one explicitly, for example: sanity --branch main"
      fi
    fi

    if ! git -C "$repo_root" rev-parse --verify --quiet "$branch_base^{commit}" >/dev/null; then
      fatal "Branch base ref '$branch_base' does not exist."
    fi

    if ! git -C "$repo_root" merge-base "$branch_base" HEAD >/dev/null; then
      fatal "Branch base ref '$branch_base' has no merge base with HEAD."
    fi

    git_args=(diff --name-only -z --diff-filter=ACMR "$branch_base...HEAD")
    ;;
esac

tmp_files="$(mktemp)"
trap 'rm -f "$tmp_files"' EXIT

while IFS= read -r -d '' path; do
  case "$path" in
    *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.mts|*.cts)
      if [[ -f "$repo_root/$path" ]]; then
        printf '%s\0' "$path" >>"$tmp_files"
      fi
      ;;
  esac
done < <(git -C "$repo_root" "${git_args[@]}")

if [[ ! -s "$tmp_files" ]]; then
  if [[ "$json" == "1" ]]; then
    print_and_maybe_copy '[]'
  else
    output="$(gum style --foreground 34 --bold "No JavaScript or TypeScript files to check.")"
    print_and_maybe_copy "$output"
  fi
  exit 0
fi

if [[ "$clipboard" == "1" ]]; then
  set +e
  output="$(SANITY_REPO_ROOT="$repo_root" SANITY_MODE="$mode" SANITY_BRANCH_BASE="$branch_base" SANITY_JSON="$json" node "$runner" <"$tmp_files")"
  status=$?
  clipboard_output="$(env -u FORCE_COLOR NO_COLOR=1 SANITY_REPO_ROOT="$repo_root" SANITY_MODE="$mode" SANITY_BRANCH_BASE="$branch_base" SANITY_JSON="$json" node "$runner" <"$tmp_files")"
  set -e

  printf '%s\n' "$output"
  if ! printf '%s\n' "$clipboard_output" | copy_to_clipboard; then
    printf 'sanity could not find a supported clipboard command.\n' >&2
  fi
  exit "$status"
fi

SANITY_REPO_ROOT="$repo_root" SANITY_MODE="$mode" SANITY_BRANCH_BASE="$branch_base" SANITY_JSON="$json" node "$runner" <"$tmp_files"
