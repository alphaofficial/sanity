{
  "name": "@local/sanity",
  "version": "0.1.0",
  "description": "Standalone staged JavaScript and TypeScript sanity checker.",
  "type": "module",
  "bin": {
    "sanity": "./bin/sanity"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "lint": "node src/run-eslint.js --self-test",
    "check": "node --check src/run-eslint.js"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
